[global]
origin = top-right
offset = 16x16
gap_size = 10
width = 380
min_icon_size = 40
max_icon_size = 40
icon_corner_radius = 8
corner_radius = 20
frame_width = 2
padding = 16
horizontal_padding = 18
font = DM Sans 11
format = <b>%s</b>\n%b
transparency = 10
timeout = 6000
background = "#1A1A1A"
foreground = "#F0F0F0"
frame_color = "#2E2E2E"

[urgency_low]
background = "#1A1A1A"
foreground = "#888888"
frame_color = "#2E2E2E"
timeout = 4000

[urgency_normal]
background = "#1A1A1A"
foreground = "#F0F0F0"
frame_color = "#8FE56D"
timeout = 6000

[urgency_critical]
background = "#1A1A1A"
foreground = "#F0F0F0"
frame_color = "#FF6B1A"
timeout = 0
