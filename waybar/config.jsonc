{
  "layer": "top",
  "position": "top",
  "height": 48,
  "spacing": 8,
  "margin-top": 8,
  "margin-right": 12,
  "margin-left": 12,
  "margin-bottom": 0,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray", "custom/power"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    },
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
    "tooltip": false
  },

  "clock": {
    "interval": 60,
    "format": "{:%A  %d %b  %H:%M}",
    "tooltip": false
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false
  },

  "network": {
    "interval": 5,
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  connected",
    "format-disconnected": "󰤭  offline",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": " {icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
