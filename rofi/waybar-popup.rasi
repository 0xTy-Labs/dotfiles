* {
    bg-color:            rgba(20, 20, 30, 0.95);
    bg-lighter:          rgba(30, 30, 45, 0.7);
    fg-color:            #ffffff;
    fg-dim:              #b0b0b0;
    accent:              #00ff99;
    accent-dim:          rgba(0, 255, 153, 0.3);
    
    background-color:    transparent;
    text-color:          @fg-color;
    border-color:        rgba(0, 255, 153, 0.3);
}

window {
    background-color:    @bg-color;
    border:              2px solid;
    border-color:        @border-color;
    border-radius:       12px;
    padding:             16px;
    width:               300px;
}

mainbox {
    border:              0;
    padding:             0;
    spacing:             8px;
}

inputbar {
    spacing:             8px;
    padding:             10px 12px;
    border-radius:       8px;
    background-color:    @bg-lighter;
    border:              1px solid;
    border-color:        @accent-dim;
    children:            [ prompt ];
}

prompt {
    text-color:          @accent;
    background-color:    transparent;
}

listview {
    background-color:    transparent;
    border:              0;
    padding:             4px 0;
    spacing:             4px;
    scrollbar:           false;
    lines:               8;
}

element {
    padding:             8px 10px;
    border-radius:       6px;
    background-color:    transparent;
    text-color:          @fg-color;
    border:              1px solid;
}

element selected.normal {
    background-color:    @accent-dim;
    text-color:          @accent;
    border-color:        @accent;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
}
