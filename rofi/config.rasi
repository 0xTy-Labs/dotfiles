* {
  bg:                 #1A1A1A;
  shadow-light:       #2E2E2E;
  shadow-dark:        #0A0A0A;
  orange:             #FF6B1A;
  orange-dim:         #CC5510;
  orange-glow:        rgba(255, 107, 26, 0.25);
  green:              #8FE56D;
  text-primary:       #F0F0F0;
  text-secondary:     #888888;
  text-muted:         #555555;

  background-color:   transparent;
  text-color:         @text-primary;
  border-color:       @shadow-light;
  spacing:            12;
}

window {
  width:              480px;
  location:           center;
  anchor:             center;
  background-color:   @bg;
  border:             0;
  border-radius:      32px;
  padding:            24px;
}

mainbox {
  spacing:            16px;
  background-color:   transparent;
}

inputbar {
  spacing:            10px;
  padding:            12px 16px;
  border:             0;
  border-radius:      18px;
  background-color:   @bg;
  text-color:         @text-primary;
  children:           [prompt, entry];
}

prompt {
  text-color:         @orange;
  background-color:   transparent;
  font:               "Syne 700 14";
}

entry {
  text-color:         @text-primary;
  placeholder:        "Search";
  placeholder-color:  @text-muted;
  background-color:   transparent;
  font:               "DM Sans 400 13";
}

listview {
  lines:              8;
  fixed-height:       true;
  dynamic:            true;
  scrollbar:          false;
  border:             0;
  padding:            4px 0;
  spacing:            8px;
  background-color:   transparent;
}

element {
  padding:            10px 14px;
  border:             0;
  border-radius:      18px;
  background-color:   transparent;
  text-color:         @text-secondary;
}

element normal.normal {
  background-color:   transparent;
  text-color:         @text-secondary;
}

element selected.normal {
  background-color:   @bg;
  text-color:         @text-primary;
  border:             2px;
  border-color:       @orange;
}

element selected.active {
  background-color:   @bg;
  text-color:         @green;
  border:             2px;
  border-color:       @green;
}

element selected.urgent {
  background-color:   @bg;
  text-color:         @orange;
  border:             2px;
  border-color:       @orange;
}

element-icon {
  size:               1.1em;
  background-color:   transparent;
}

element-text {
  background-color:   transparent;
  text-color:         inherit;
  font:               "DM Sans 400 13";
}

message,
textbox,
error-message {
  background-color:   transparent;
  text-color:         @text-primary;
}
