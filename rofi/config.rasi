/******************************************************************************
 * ROFI Theme - Solarised glass
 * Tyler 2026
 ******************************************************************************/

* {
    /* Color Palette */
    accent-cyan:     #00ff99;
    accent-blue:     #268bd2;
    accent-pink:     #ff006e;
    accent-orange:   #ff8c42;
    
    text-primary:    #ffffff;
    text-secondary:  #b0b0b0;
    text-dim:        #808080;
    
    /* Glassmorphism Background - semi-transparent with blur effect */
    glass-background:           rgba(20, 20, 30, 0.75);
    glass-background-light:     rgba(30, 30, 45, 0.65);
    glass-background-lighter:   rgba(40, 40, 55, 0.55);
    
    /* Selection and highlight colors */
    selection-background:       rgba(0, 255, 153, 0.15);
    selection-border:           #00ff99;
    
    /* Transparent base */
    transparent:                rgba(0, 0, 0, 0);
    
    /* State colors */
    urgent-color:               #ff006e;
    active-color:               #00ff99;
    
    /* Main settings */
    background-color:           @transparent;
    border-color:               rgba(255, 255, 255, 0.1);
    spacing:                    8;
}

window {
    /* Main glass container */
    background-color:   @glass-background;
    border:             2px solid;
    border-color:       rgba(0, 255, 153, 0.3);
    border-radius:      20px;
    padding:            30px;
    width:              600px;
    
    /* Subtle shadow effect */
    location:           center;
    anchor:             center;
}

mainbox {
    border:             0;
    padding:            0;
    spacing:            15px;
    background-color:   @transparent;
}

/* Input bar - the search field */
inputbar {
    spacing:            10px;
    padding:            15px 20px;
    border-radius:      12px;
    background-color:   @glass-background-lighter;
    border:             1px solid;
    border-color:       rgba(255, 255, 255, 0.1);
    text-color:         @text-primary;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @accent-cyan;
    background-color:   @transparent;
    font:               "Inter Bold 11";
}

entry {
    text-color:         @text-primary;
    placeholder-color:  @text-dim;
    placeholder:        "Search...";
    background-color:   @transparent;
}

/* Results list */
listview {
    background-color:   @transparent;
    border:             0;
    padding:            10px 0px;
    spacing:            6px;
    scrollbar:          true;
    fixed-height:       true;
    lines:              8;
}

/* Individual list items */
element {
    padding:            12px 16px;
    border-radius:      10px;
    background-color:   @transparent;
    text-color:         @text-secondary;
    border:             1px solid;
    border-color:       @transparent;
    spacing:            10px;
}

element normal.normal {
    background-color:   @transparent;
    text-color:         @text-secondary;
}

element selected.normal {
    background-color:   @selection-background;
    text-color:         @text-primary;
    border-color:       @selection-border;
    font:               "Inter SemiBold 10";
}

element alternate.normal {
    background-color:   @transparent;
    text-color:         @text-secondary;
}

/* Hover effect */
element selected.normal {
    background-color:   rgba(0, 255, 153, 0.2);
    border-color:       rgba(0, 255, 153, 0.5);
}

/* Active and urgent states */
element normal.active,
element alternate.active {
    background-color:   @transparent;
    text-color:         @active-color;
}

element selected.active {
    background-color:   rgba(0, 255, 153, 0.25);
    text-color:         @active-color;
    border-color:       @active-color;
}

element normal.urgent,
element alternate.urgent {
    background-color:   @transparent;
    text-color:         @urgent-color;
}

element selected.urgent {
    background-color:   rgba(255, 0, 110, 0.2);
    text-color:         @urgent-color;
    border-color:       @urgent-color;
}

/* Scrollbar */
scrollbar {
    width:              4px;
    border:             0;
    handle-width:       6px;
    handle-color:       rgba(0, 255, 153, 0.4);
    background-color:   rgba(255, 255, 255, 0.05);
    border-radius:      4px;
    padding:            0;
    margin:             0px 0px 0px 8px;
}

/* Mode switcher (if used) */
mode-switcher {
    spacing:            10px;
    padding:            10px 0px 0px 0px;
    border:             0;
}

button {
    padding:            10px 20px;
    border-radius:      8px;
    background-color:   @glass-background-light;
    text-color:         @text-secondary;
    border:             1px solid;
    border-color:       rgba(255, 255, 255, 0.1);
}

button selected {
    background-color:   @selection-background;
    text-color:         @accent-cyan;
    border-color:       @selection-border;
}

/* Message box */
message {
    padding:            15px;
    border-radius:      10px;
    background-color:   @glass-background-lighter;
    border:             1px solid;
    border-color:       rgba(255, 255, 255, 0.1);
}

textbox {
    text-color:         @text-primary;
    background-color:   @transparent;
}

/* Case indicator */
case-indicator {
    text-color:         @text-dim;
    background-color:   @transparent;
}

/* Element text - for better typography */
element-text {
    background-color:   @transparent;
    text-color:         inherit;
    vertical-align:     0.5;
}

element-icon {
    background-color:   @transparent;
    size:               1.2em;
}